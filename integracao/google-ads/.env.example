# Modelo de credenciais da integração Google Ads (conta direta, sem MCC).
# No Claude Code web, cadastre estes valores como variáveis de ambiente do
# AMBIENTE do projeto (não commite um .env preenchido — o .gitignore bloqueia).
# Passo a passo de obtenção: integracao/google-ads/SETUP.md

GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# Deixe vazia (ou nem cadastre) para acesso direto à conta — modo padrão.
# Só preencher se a operação um dia migrar para MCC.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Opcional; padrão v21.
GOOGLE_ADS_API_VERSION=
